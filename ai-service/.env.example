# Copy to .env and fill in. .env is never committed.

# Port this service listens on (Express calls http://localhost:8000)
AI_PORT=8000

# Same database as the backend (see backend/.env)
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=

# Keep downloaded models on D: — C: has little free space
HF_HOME=D:/My Folder/blog-app/ai-service/models/hf-cache
