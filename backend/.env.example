# Copy to .env for local development. On the hosting site (e.g. Render) set these as environment
# variables instead. Never commit .env.

# --- Server ---
# PORT=3000                     # hosts like Render set this automatically

# --- Database: EITHER a connection string (production) ---
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DB_SSL=false                  # only to test DATABASE_URL against a local database without SSL

# --- … OR separate values (local development) ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Auth ---
JWT_SECRET=                     # long random string; different in production

# --- Images ---
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>   # set → images go to Cloudinary;
#                                                                    # unset → saved in backend/images/

# --- AI ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AI_SERVICE_URL=http://localhost:8000   # the Python intent service (default shown)
